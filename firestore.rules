rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Defaults to requiring approval when the settings doc hasn't been created yet,
    // matching the client's DEFAULT_MODERATION_SETTINGS.
    function moderationRequiresApproval() {
      return !exists(/databases/$(database)/documents/settings/moderation) ||
        get(/databases/$(database)/documents/settings/moderation).data.requireApproval != false;
    }

    match /posts/{postId} {
      // A post is publicly visible only once approved; admins can also read
      // pending/rejected posts for the moderation queue.
      allow read: if resource.data.status == 'approved' || isAdmin();

      allow create: if request.resource.data.keys().hasOnly(
                        ['text', 'imageUrl', 'nsfw', 'createdAt', 'expiresAt', 'status', 'reactions', 'comments']
                      )
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 280
                      && request.resource.data.nsfw is bool
                      && request.resource.data.reactions == {}
                      && request.resource.data.comments == []
                      && request.resource.data.status ==
                          (moderationRequiresApproval() ? 'pending' : 'approved');

      // Admins may approve/reject (status only). Anyone may update reaction
      // counts, and anyone may append exactly one comment at a time — the
      // size()-grew-by-exactly-1 check blocks wholesale replacement/deletion
      // of existing comments through this same field, and the new last
      // entry's text is length-validated the same way post text is above.
      allow update: if (isAdmin()
                          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
                          && request.resource.data.status in ['approved', 'rejected'])
                      || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
                      || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comments'])
                          && request.resource.data.comments.size() == resource.data.comments.size() + 1
                          && request.resource.data.comments[request.resource.data.comments.size() - 1].text is string
                          && request.resource.data.comments[request.resource.data.comments.size() - 1].text.size() > 0
                          && request.resource.data.comments[request.resource.data.comments.size() - 1].text.size() <= 200);

      allow delete: if false;
    }

    match /messages/{messageId} {
      // Kind Words board: not moderated, always publicly readable/writable —
      // unlike posts, these carry the author's own name, so there's no
      // anonymity to protect and no approval workflow attached.
      allow read: if true;

      allow create: if request.resource.data.keys().hasOnly(
                        ['name', 'photoUrl', 'text', 'createdAt']
                      )
                      && request.resource.data.name is string
                      && request.resource.data.name.size() > 0
                      && request.resource.data.name.size() <= 60
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 600;

      allow update: if false;
      allow delete: if false;
    }

    match /photoEntries/{entryId} {
      // Photos & Personal Info board: like Kind Words, named and unmoderated.
      // Each entry needs a username plus at least one of a message, a pasted
      // photo link, or an uploaded picture.
      allow read: if true;

      allow create: if request.resource.data.keys().hasOnly(
                        ['username', 'text', 'photoLink', 'instagram', 'photoUrl', 'createdAt']
                      )
                      && request.resource.data.username is string
                      && request.resource.data.username.size() > 0
                      && request.resource.data.username.size() <= 60
                      && request.resource.data.text is string
                      && request.resource.data.text.size() <= 600
                      && (request.resource.data.photoLink == null
                          || (request.resource.data.photoLink is string
                              && request.resource.data.photoLink.size() <= 500))
                      && (request.resource.data.instagram == null
                          || (request.resource.data.instagram is string
                              && request.resource.data.instagram.size() <= 40))
                      && (request.resource.data.text.size() > 0
                          || (request.resource.data.photoLink != null && request.resource.data.photoLink.size() > 0)
                          || request.resource.data.photoUrl != null);

      allow update: if false;
      allow delete: if false;
    }

    match /settings/moderation {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Bootstrap the first admin manually from the Firebase console (create a doc here
    // with the admin's Auth uid as the document id). No client can write this collection.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
