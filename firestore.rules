rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Defaults to requiring approval when the settings doc hasn't been created yet,
    // matching the client's DEFAULT_MODERATION_SETTINGS.
    function moderationRequiresApproval() {
      return !exists(/databases/$(database)/documents/settings/moderation) ||
        get(/databases/$(database)/documents/settings/moderation).data.requireApproval != false;
    }

    // Uploaded pictures are stored as Storage download URLs (~200 chars); the
    // cap stops a client parking a ~1MB data: URL in the document itself and
    // bloating every visitor's listen. Callers pass .get(key, null) so that an
    // absent key reads as null instead of raising an evaluation error.
    function validPhotoUrl(photoUrl) {
      return photoUrl == null || (photoUrl is string && photoUrl.size() <= 500);
    }

    match /posts/{postId} {
      // A post is publicly visible only once approved; admins can also read
      // pending/rejected posts for the moderation queue.
      allow read: if resource.data.status == 'approved' || isAdmin();

      allow create: if request.resource.data.keys().hasOnly(
                        ['text', 'imageUrl', 'nsfw', 'createdAt', 'status', 'reactions', 'comments']
                      )
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 280
                      && request.resource.data.nsfw is bool
                      && request.resource.data.reactions == {}
                      && request.resource.data.comments == []
                      && request.resource.data.status ==
                          (moderationRequiresApproval() ? 'pending' : 'approved');

      // Admins may approve/reject (status only) or override the nsfw flag.
      // Anyone may update reaction counts, and anyone may append exactly one
      // comment at a time — the size()-grew-by-exactly-1 check blocks
      // wholesale replacement/deletion of existing comments through this
      // same field, and the new last entry's text is length-validated the
      // same way post text is above.
      allow update: if (isAdmin()
                          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
                          && request.resource.data.status in ['approved', 'rejected'])
                      || (isAdmin()
                          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nsfw'])
                          && request.resource.data.nsfw is bool)
                      || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
                      || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comments'])
                          && request.resource.data.comments.size() == resource.data.comments.size() + 1
                          && request.resource.data.comments[request.resource.data.comments.size() - 1].text is string
                          && request.resource.data.comments[request.resource.data.comments.size() - 1].text.size() > 0
                          && request.resource.data.comments[request.resource.data.comments.size() - 1].text.size() <= 200);

      allow delete: if false;
    }

    match /messages/{messageId} {
      // Kind Words board: not moderated, always publicly readable/writable —
      // unlike posts, these carry the author's own name, so there's no
      // anonymity to protect and no approval workflow attached.
      //
      // Read is unconditional on purpose, soft-deleted entries included. A
      // per-document gate such as `resource.data.get('deleted', false) != true`
      // cannot be satisfied by this board's listen: Firestore evaluates list
      // rules against a query's *potential* result set, so an unconstrained
      // orderBy('createdAt') query whose rule depends on a per-document field
      // is rejected outright for any reader who doesn't short-circuit the rule
      // (the same mechanic spelled out above firestoreSubscribeToAllPosts).
      // Constraining the query with where('deleted', '==', false) instead
      // would hide every document written before that field existed, since an
      // equality filter skips documents missing the field entirely — and the
      // update rule below only ever allows deleted -> true, so those documents
      // cannot be backfilled from a client. Both backends filter `deleted` out
      // of the subscription callback instead: a soft-deleted entry vanishes
      // from the board while its document stays readable, consistent with this
      // app's nothing-is-ever-really-deleted posture elsewhere.
      allow read: if true;

      allow create: if request.resource.data.keys().hasOnly(
                        ['name', 'photoUrl', 'text', 'createdAt', 'authorId']
                      )
                      && request.resource.data.name is string
                      && request.resource.data.name.size() > 0
                      && request.resource.data.name.size() <= 60
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 600
                      && validPhotoUrl(request.resource.data.get('photoUrl', null))
                      && request.resource.data.authorId is string
                      && request.resource.data.authorId.size() > 0
                      && request.resource.data.authorId.size() <= 100;

      // Edit and soft-delete deliberately carry no server-side author check.
      // `authorId` is a per-browser id stamped at creation, and because this
      // collection is publicly readable anyone can read another entry's id and
      // replay it — so comparing it against a client-supplied value enforces
      // nothing. (An earlier revision compared resource.data.authorId against
      // request.resource.data.authorId, which is vacuous besides: the
      // affectedKeys().hasOnly() clauses below already forbid touching
      // authorId, so the two sides could never differ.) Ownership is a UI
      // affordance only — MessageCard shows edit/delete when
      // `message.authorId === getAuthorId()` — the same tradeoff already
      // accepted for the reactions map, which anyone can likewise rewrite.
      // Real per-author enforcement would need Firebase Anonymous Auth,
      // deliberately out of scope here.
      //
      // What this rule does still enforce is the shape of the write: a content
      // edit may touch only name/text/photoUrl and must stay length-valid, and
      // a delete may only ever set `deleted` to true — never back to false,
      // and never bundled with other fields. Soft-deleting rather than really
      // deleting also sidesteps the fact that a real `delete` request carries
      // no request.resource to validate at all.
      allow update: if (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'text', 'photoUrl'])
                          && request.resource.data.name is string
                          && request.resource.data.name.size() > 0
                          && request.resource.data.name.size() <= 60
                          && request.resource.data.text is string
                          && request.resource.data.text.size() > 0
                          && request.resource.data.text.size() <= 600
                          && validPhotoUrl(request.resource.data.get('photoUrl', null)))
                      || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted'])
                          && request.resource.data.deleted == true);

      allow delete: if false;
    }

    match /photoEntries/{entryId} {
      // Photos & Personal Info board: like Kind Words, named and unmoderated.
      // Each entry needs a username plus at least one of a message, a pasted
      // photo link, or an uploaded picture. Read visibility and the absence of
      // a server-side author check follow the same reasoning as messages
      // above — see the two comments there.
      allow read: if true;

      allow create: if request.resource.data.keys().hasOnly(
                        ['username', 'text', 'photoLink', 'instagram', 'photoUrl', 'createdAt', 'authorId']
                      )
                      && request.resource.data.username is string
                      && request.resource.data.username.size() > 0
                      && request.resource.data.username.size() <= 60
                      && request.resource.data.text is string
                      && request.resource.data.text.size() <= 600
                      && (request.resource.data.photoLink == null
                          || (request.resource.data.photoLink is string
                              && request.resource.data.photoLink.size() <= 500))
                      && (request.resource.data.instagram == null
                          || (request.resource.data.instagram is string
                              && request.resource.data.instagram.size() <= 40))
                      && validPhotoUrl(request.resource.data.get('photoUrl', null))
                      && (request.resource.data.text.size() > 0
                          || (request.resource.data.photoLink != null && request.resource.data.photoLink.size() > 0)
                          || request.resource.data.photoUrl != null)
                      && request.resource.data.authorId is string
                      && request.resource.data.authorId.size() > 0
                      && request.resource.data.authorId.size() <= 100;

      allow update: if (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['username', 'text', 'photoLink', 'instagram', 'photoUrl'])
                          && request.resource.data.username is string
                          && request.resource.data.username.size() > 0
                          && request.resource.data.username.size() <= 60
                          && request.resource.data.text is string
                          && request.resource.data.text.size() <= 600
                          && (request.resource.data.photoLink == null
                              || (request.resource.data.photoLink is string
                                  && request.resource.data.photoLink.size() <= 500))
                          && (request.resource.data.instagram == null
                              || (request.resource.data.instagram is string
                                  && request.resource.data.instagram.size() <= 40))
                          && validPhotoUrl(request.resource.data.get('photoUrl', null))
                          && (request.resource.data.text.size() > 0
                              || (request.resource.data.photoLink != null && request.resource.data.photoLink.size() > 0)
                              || request.resource.data.photoUrl != null))
                      || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted'])
                          && request.resource.data.deleted == true);

      allow delete: if false;
    }

    match /settings/moderation {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Bootstrap the first admin manually from the Firebase console (create a doc here
    // with the admin's Auth uid as the document id). No client can write this collection.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
