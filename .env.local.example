# Copy this file to .env.local and fill in values from your Firebase project
# settings (Project settings -> General -> Your apps -> SDK setup and config).
#
# Leave .env.local absent (or these unset) and the app automatically runs in
# local demo mode, storing posts in the browser's localStorage instead.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Local demo mode only (no Firebase config above): passcode for the /admin
# page. This is a convenience gate for the prototype, NOT real security —
# real admin access control comes from Firebase Auth + the `admins`
# collection once Firebase is configured. Defaults to "alexissmart" if unset.
NEXT_PUBLIC_LOCAL_ADMIN_PASSCODE=
