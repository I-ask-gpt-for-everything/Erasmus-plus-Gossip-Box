rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /gossip-images/{imageId} {
      allow read: if true;
      allow write: if request.resource.size < 8 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
    }

    match /message-photos/{photoId} {
      allow read: if true;
      allow write: if request.resource.size < 8 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
    }
  }
}
